# Atlas — monorepo environment template.
# Copy to `.env` at the repo root: `cp .env.example .env`
# The docker-compose stack reads this single file; the two apps each read
# their own subset of the variables below.
#
# ═══════════════════════════════════════════════════════════════════════════
# Two kinds of configuration:
#
# 1. BOOT-CRITICAL (below) — the minimum Atlas needs to start. Everything
#    else is optional here because it can be configured from the browser:
#
# 2. GODMODE — open http://<host>:3001/godmode after first boot, unlock
#    with GODMODE_PASSPHRASE, and configure auth methods, providers,
#    storage, integrations, roles, and feature gates there. Settings take
#    effect without a redeploy. The optional env vars at the bottom of
#    this file remain as fallbacks for operators who prefer .env-driven
#    configuration, and keep existing deployments working unchanged.
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# ─── Boot-critical ──────────────────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════

# ─── App ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://atlas.example.com
API_GLOBAL_PREFIX=api/v1
# Comma-separated list of allowed browser origins (the frontend host).
CORS_ORIGINS=https://atlas.example.com

# ─── Database (external host) ───────────────────────────────────────────
DATABASE_HOST=host
DATABASE_PORT=5432
DATABASE_NAME=atlas
DATABASE_USER=atlas
DATABASE_PASSWORD=password
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# ─── Internal signing secret ────────────────────────────────────────────
# 64 hex characters. Signs internal tokens AND is the key material for
# the godmode secrets store — generate once with: openssl rand -hex 32
INTERNAL_JWT_SECRET=replace_me_with_64_hex_characters

# ─── Godmode (the control plane) ────────────────────────────────────────
# The passphrase that unlocks /godmode. Anyone with this passphrase (and
# the optional 2FA) can reconfigure the instance, so pick a strong one.
GODMODE_PASSPHRASE=replace_me_with_a_long_random_passphrase

# ═══════════════════════════════════════════════════════════════════════════
# ─── Frontend (apps/frontend) ──────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════════════════
PORT=3001
HOST_PORT=3001

# ─── Public ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are baked into the Docker build — changing them
# requires a rebuild, not just a restart.
NEXT_PUBLIC_APP_URL=https://atlas.example.com
NEXT_PUBLIC_API_URL=https://atlas.example.com/api/v1

# Optional. The chat WebSocket origin. When unset the runtime derives it
# from NEXT_PUBLIC_API_URL minus the /api/vN suffix.
NEXT_PUBLIC_SOCKET_URL=

# ─── Auth.js (legacy, unused — kept for older images) ──────────────────────
AUTH_SECRET=change-this
AUTH_TRUST_HOST=true
AUTH_URL=https://atlas.example.com

# ═══════════════════════════════════════════════════════════════════════════
# ─── Optional fallbacks (everything here is also configurable in godmode) ──
# ═══════════════════════════════════════════════════════════════════════════
# Godmode settings take precedence over these values. Keep them empty to
# use godmode exclusively.

# ─── Observability ───────────────────────────────────────────────────────
# Bearer token for GET /api/v1/metrics (Prometheus scrape). Empty → 404.
METRICS_TOKEN=
# Sentry/GlitchTip DSN for error tracking. Empty → no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# ─── Storage (S3-compatible) ─────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOAD_PRESIGN_TTL=300

# ─── Upload limits ────────────────────────────────────────────────────────
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_GALLERY_ITEMS=10
MEDIA_ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/gif
MEDIA_ALLOWED_VIDEO_MIME=video/mp4,video/webm

# ─── Email (SMTP fallback; provider choice lives in godmode) ──────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@atlas.example.com
MAIL_FROM_NAME=Atlas

# ─── Keycloak (legacy env-based OIDC; optional now) ───────────────────────
# Prefer the Keycloak provider card in godmode → OAuth providers.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URI=
KEYCLOAK_AUDIENCE=account
# Verify Keycloak tokens on /auth/login (default true). Emergency switch only.
AUTH_VERIFY_TOKENS=true
KEYCLOAK_CLIENT_SECRET=

# ─── n8n webhook ──────────────────────────────────────────────────────────
N8N_BASE_URL=
N8N_WEBHOOK_PATH=/webhook/atlas
N8N_WEBHOOK_SECRET=

# ─── Legacy bootstrap admin (optional) ────────────────────────────────────
# Kept for existing deployments. New installs: create accounts in godmode.
BOOTSTRAP_ADMIN_EMAIL=
ADMIN_NOTIFICATION_EMAILS=

# ─── Throttler ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ─── Chat realtime ────────────────────────────────────────────────────────
# Leave REDIS_URL empty to keep chat in REST/polling mode (sockets disabled).
REDIS_URL=
CHAT_SOCKET_PATH=/socket.io
CHAT_LINK_PREVIEW_CACHE_TTL=86400
CHAT_MAX_ATTACHMENTS_PER_MESSAGE=10
CHAT_MAX_ATTACHMENT_BYTES=52428800
CHAT_EDIT_WINDOW_HOURS=24

# GIF keys (also configurable in godmode → Integrations).
TENOR_API_KEY=
GIPHY_API_KEY=

# ─── PMO (project management office) ──────────────────────────────────────
# Global kill switch; also toggleable in godmode → Modules.
PMO_ENABLED=false
PMO_MAX_TASKS_PER_LIST=2000
PMO_MAX_LISTS_PER_PROJECT=50
PMO_MAX_NOTES_PER_PROJECT=500
PMO_MAX_WHITEBOARDS_PER_PROJECT=100
PMO_MAX_TABS_PER_LIST=20
PMO_FILE_MAX_BYTES=52428800
# Comma-separated MIME allowlist for the Files tab. Use * for any.
PMO_FILE_ALLOWED_MIME=*

# ─── Yjs realtime collab (notes + whiteboards) ────────────────────────────
# Leave empty to keep notes/whiteboards in single-edit mode.
YJS_PUBLIC_WS_URL=
YJS_INTERNAL_AUTH_SECRET=
YJS_SNAPSHOT_DEBOUNCE_MS=30000
YJS_HOST_PORT=1234

# ─── Voice chat (LiveKit) ─────────────────────────────────────────────────
# Global kill switch; also toggleable in godmode → Modules.
VOICE_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_KEY=
VOICE_JWT_TTL_SECONDS=14400
VOICE_DEFAULT_USER_LIMIT=0
VOICE_RECORDING_RETENTION_DAYS=30
LIVEKIT_HOST_PORT=7880

# ─── Web Push (browser notifications) ─────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# Also configurable in godmode → Integrations.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@atlas.example.com
